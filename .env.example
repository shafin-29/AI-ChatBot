# Copy this file to `.env` and fill in your key.   cp .env.example .env


# --- Required ---------------------------------------------------------------
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-key-here"


# --- Optional (defaults shown) ----------------------------------------------
# Model used when the app starts (any OpenRouter model ID).
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Comma-separated list shown only if the live free-model list can't be fetched.
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_TEMPERATURE=0.7

# Max history (approx. tokens) sent per request. Older turns are trimmed first.
# MAX_CONTEXT_TOKENS=16000

# Seconds to wait for a response, and how many times to retry rate limits / blips.
# REQUEST_TIMEOUT=60
# MAX_RETRIES=4

# Shown to OpenRouter in request headers (optional).
# APP_TITLE=AI Chatbot
# APP_URL=https://your-app.example.com
